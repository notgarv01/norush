# ==============================================================================
# NoRush Smart Tourism Intelligence Engine - Environment Variables
# ==============================================================================
# Port for local server (defaults to 8080)
PORT=8080

# Google Gemini AI API Keys (Primary & Fallbacks)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_BACKUP=your_backup_gemini_key_here
GEMINI_API_KEY_2=your_tertiary_gemini_key_here

# TomTom Traffic API Key (Live Corridor Telemetry)
TOMTOM_API_KEY=your_tomtom_api_key_here

# Unsplash Image API Access Key (Live Photography Pipeline)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
